# Copy this file to .env and fill in only what you use.
# .env is git-ignored. Never paste keys into chat or commit them.

# --- Server ---
ATLAS_PORT=4317
# Leave as 127.0.0.1 so only this computer can reach Atlas.
ATLAS_HOST=127.0.0.1
# Required only if ATLAS_HOST is not 127.0.0.1 (e.g. to open Atlas from your iPad on home Wi-Fi).
# Use a long random string. Open http://<computer-ip>:4317/?token=<this value> once on the iPad.
ATLAS_ACCESS_TOKEN=
# Where the database, uploads and backups live (default: ./data)
ATLAS_DATA_DIR=

# --- AI providers (any one is enough) ---
ANTHROPIC_API_KEY=
# Default Claude model. claude-opus-5-5 is the most capable general model.
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
# Ollama runs models free on your own computer: https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Integrations (optional) ---
GITHUB_TOKEN=
FIGMA_TOKEN=
ALPHAVANTAGE_API_KEY=
