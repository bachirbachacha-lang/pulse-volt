<section class="page-section section-pad-md">
  <div class="page-width">
    <h1 class="h2">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="product-list">
        {%- for article in blog.articles -%}
          <a class="product-card" href="{{ article.url }}">
            {%- if article.image -%}
              <div class="product-card__img">{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}</div>
            {%- endif -%}
            <p class="product-card__title">{{ article.title }}</p>
            <p class="product-card__price">{{ article.published_at | date: '%b %d, %Y' }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
