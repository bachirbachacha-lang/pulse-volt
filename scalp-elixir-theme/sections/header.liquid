<header class="site-header{% if section.settings.sticky %} is-sticky{% endif %}" data-header>
  <div class="page-width site-header__inner">
    <details class="menu-drawer" data-menu-drawer>
      <summary class="icon-btn menu-drawer__toggle" aria-label="Menu">
        {% render 'icon', name: 'menu' %}
      </summary>
      <div class="menu-drawer__panel">
        <nav aria-label="Mobile">
          <ul>
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
        {%- if shop.customer_accounts_enabled -%}
          <a class="menu-drawer__account" href="{{ routes.account_url }}">{% render 'icon', name: 'user' %} Account</a>
        {%- endif -%}
      </div>
    </details>

    <a class="site-logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag: width: section.settings.logo_width, height: logo_height, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <span class="site-logo__text">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn hide-mobile" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a class="icon-btn cart-toggle" href="{{ routes.cart_url }}" aria-label="Cart" data-cart-open>
        {% render 'icon', name: 'bag' %}
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 140 },
    { "type": "text", "id": "logo_text", "label": "Logo text", "info": "Shown when no logo image is set.", "default": "Scalp Elixir" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top when scrolling", "default": true }
  ]
}
{% endschema %}
