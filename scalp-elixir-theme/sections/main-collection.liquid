<section class="page-section section-pad-md">
  <div class="page-width">
    <header class="section-head section-head--left">
      <h1 class="h2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte lead">{{ collection.description }}</div>{%- endif -%}
    </header>
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="product-list">
        {%- for card in collection.products -%}
          {% render 'product-card', card: card %}
        {%- else -%}
          <p>No products yet.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 4, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
