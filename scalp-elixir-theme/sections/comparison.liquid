{%- assign sk = 'content.' | append: section.id | append: '.' -%}
<section class="comparison section-pad-md" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width comparison__wrap">
    <header class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{% render 'tr', value: section.settings.eyebrow, scope: sk, field: 'eyebrow' %}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{% render 'tr', value: section.settings.heading, scope: sk, field: 'heading' %}</h2>{%- endif -%}
    </header>
    <div class="comparison__table" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="comparison__row comparison__row--head" role="row">
        <span role="columnheader"><span class="visually-hidden">{{ 'comparison.feature' | t }}</span></span>
        <span role="columnheader" class="is-us">{% render 'tr', value: section.settings.us_label, scope: sk, field: 'us_label' %}</span>
        <span role="columnheader">{% render 'tr', value: section.settings.them_label, scope: sk, field: 'them_label' %}</span>
      </div>
      {%- for block in section.blocks -%}
        {%- assign bk = sk | append: block.id | append: '.' -%}
        <div class="comparison__row" role="row" {{ block.shopify_attributes }}>
          <span role="rowheader">{% render 'tr', value: block.settings.feature, scope: bk, field: 'feature' %}</span>
          <span role="cell" class="is-us">
            {%- if block.settings.us -%}{% render 'icon', name: 'check' %}<span class="visually-hidden">{{ 'comparison.yes' | t }}</span>{%- else -%}{% render 'icon', name: 'x-mark' %}<span class="visually-hidden">{{ 'comparison.no' | t }}</span>{%- endif -%}
          </span>
          <span role="cell">
            {%- if block.settings.them -%}{% render 'icon', name: 'check' %}<span class="visually-hidden">{{ 'comparison.yes' | t }}</span>{%- else -%}{% render 'icon', name: 'x-mark' %}<span class="visually-hidden">{{ 'comparison.no' | t }}</span>{%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "class": "section-comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not another greasy hair oil" },
    { "type": "text", "id": "us_label", "label": "Your column", "default": "Scalp Elixir" },
    { "type": "text", "id": "them_label", "label": "Other column", "default": "Typical hair oils" },
    { "type": "text", "id": "anchor", "label": "Anchor ID" }
  ],
  "blocks": [
    {
      "type": "row", "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
        { "type": "checkbox", "id": "us", "label": "Yours has it", "default": true },
        { "type": "checkbox", "id": "them", "label": "Others have it", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Comparison table", "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
