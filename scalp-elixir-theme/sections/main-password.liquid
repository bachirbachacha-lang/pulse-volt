<section class="password section-pad-lg">
  <div class="page-width page-width--narrow empty-state">
    <p class="site-logo__text">{{ shop.name }}</p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p role="status">Thanks, we'll email you when we open.</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordEmail">Email</label>
        <input id="PasswordEmail" type="email" name="contact[email]" placeholder="Your email" required>
        <button class="btn btn--accent" type="submit">Notify me</button>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>Enter store password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="visually-hidden" for="StorePassword">Password</label>
        <input id="StorePassword" type="password" name="password" placeholder="Password" autocomplete="current-password">
        <button class="btn btn--dark" type="submit">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" } ]
}
{% endschema %}
