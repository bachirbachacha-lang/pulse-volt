<section class="password section-pad-lg">
  <div class="page-width page-width--narrow empty-state">
    <p class="site-logo__text">{{ shop.name }}</p>
    {%- assign sk = 'content.' | append: section.id | append: '.' -%}
    <h1 class="h2">{% render 'tr', value: section.settings.heading, scope: sk, field: 'heading' %}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p role="status">{{ 'password.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.email' | t }}</label>
        <input id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
        <button class="btn btn--accent" type="submit">{{ 'password.notify' | t }}</button>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
        <input id="StorePassword" type="password" name="password" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
        <button class="btn btn--dark" type="submit">{{ 'password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" } ]
}
{% endschema %}
