<section class="iwt section-pad-md{% if section.settings.style == 'deep' %} is-deep{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width iwt__grid{% if section.settings.image_right %} is-reversed{% endif %}">
    <div class="iwt__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 800, 1100, 1400', loading: 'lazy', class: 'cover' }}
      {%- else -%}
        <div class="art-panel">{% render 'bottle-art', label: shop.name %}</div>
      {%- endif -%}
    </div>
    <div class="iwt__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}
            <h2 class="h2" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="rte lead" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'point' -%}
            <div class="point" {{ block.shopify_attributes }}>
              <span class="point__icon">{% render 'icon', name: block.settings.icon %}</span>
              <div>
                <h3 class="h5">{{ block.settings.heading }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a class="btn {% if section.settings.style == 'deep' %}btn--accent{% else %}btn--dark{% endif %}" href="{{ block.settings.link | default: '#shop' }}" {{ block.shopify_attributes }}>{{ block.settings.label }} {% render 'icon', name: 'arrow' %}</a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-iwt",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "light", "label": "Light" }, { "value": "deep", "label": "Deep brand color" } ], "default": "light" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Link to this section with #your-id." }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Small heading", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Why it works" } ] },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Healthy hair starts at the scalp" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe your product here.</p>" } ] },
    {
      "type": "point", "name": "Point",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "shield", "label": "Shield" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }, { "value": "flask", "label": "Flask" }, { "value": "clock", "label": "Clock" }, { "value": "comb", "label": "Comb" } ], "default": "leaf" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Point heading" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Short supporting sentence." }
      ]
    },
    { "type": "button", "name": "Button", "limit": 1, "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Shop now" }, { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [ { "name": "Image with text", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ] } ]
}
{% endschema %}
