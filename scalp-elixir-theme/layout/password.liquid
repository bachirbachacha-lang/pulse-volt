{%- liquid
  assign rtl_languages = 'ar,he,fa,ur'
  assign text_dir = 'ltr'
  if rtl_languages contains request.locale.iso_code
    assign text_dir = 'rtl'
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ text_dir }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
