{%- liquid
  assign rtl_languages = 'ar,he,fa,ur'
  assign text_dir = 'ltr'
  if rtl_languages contains request.locale.iso_code
    assign text_dir = 'rtl'
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ text_dir }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ 'fraunces-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'inter-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | times: 100 | json }},
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          save: {{ 'products.save_percent' | t: percent: '[percent]' | json }},
          addError: {{ 'products.add_error' | t | json }},
          shippingAway: {{ 'cart.shipping_away_html' | t: amount: '[amount]' | json }},
          shippingUnlocked: {{ 'cart.shipping_unlocked_html' | t | json }},
          empty: {{ 'cart.empty' | t | json }},
          shopNow: {{ 'cart.shop_now' | t | json }},
          remove: {{ 'cart.remove' | t | json }},
          quantity: {{ 'cart.quantity' | t | json }},
          decrease: {{ 'cart.decrease' | t | json }},
          increase: {{ 'cart.increase' | t | json }}
        },
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          root: {{ routes.root_url | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
  </body>
</html>
