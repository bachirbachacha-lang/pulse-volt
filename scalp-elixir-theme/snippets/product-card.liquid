{%- comment -%} Usage: {% render 'product-card', card: product %} {%- endcomment -%}
<a class="product-card" href="{{ card.url }}">
  <div class="product-card__img">
    {%- if card.featured_media -%}
      {{ card.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 500, 700', alt: card.title }}
    {%- else -%}
      {% render 'bottle-art', label: card.title %}
    {%- endif -%}
    {%- if card.compare_at_price > card.price -%}<span class="product-card__badge">Sale</span>{%- endif -%}
  </div>
  <p class="product-card__title">{{ card.title }}</p>
  <p class="product-card__price">
    {%- if card.price_varies -%}From {% endif -%}{{ card.price | money }}
    {%- if card.compare_at_price > card.price -%} <s>{{ card.compare_at_price | money }}</s>{%- endif -%}
  </p>
</a>
