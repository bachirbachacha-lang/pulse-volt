{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Your {{ gift_card.initial_value | money }} gift card for {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="page-section section-pad-lg">
      <div class="page-width page-width--narrow empty-state">
        <p class="site-logo__text">{{ shop.name }}</p>
        <h1 class="h2">Your gift card: {{ gift_card.balance | money }}</h1>
        {%- if gift_card.expired or gift_card.enabled == false -%}<p>This gift card is no longer active.</p>{%- endif -%}
        <p class="gift-code">{{ gift_card.code | format_code }}</p>
        {%- if gift_card.qr_identifier -%}<div class="gift-qr" data-qr="{{ gift_card.qr_identifier }}"></div>{%- endif -%}
        <a class="btn btn--accent" href="{{ shop.url }}">Start shopping</a>
        {%- if gift_card.pass_url -%}<p><a href="{{ gift_card.pass_url }}">Add to Apple Wallet</a></p>{%- endif -%}
      </div>
    </main>
  </body>
</html>
