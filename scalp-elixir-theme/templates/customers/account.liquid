<section class="page-section section-pad-md">
  <div class="page-width page-width--narrow">
    <h1 class="h2">{{ 'accounts.title' | t }}</h1>
    <p><a href="{{ routes.account_logout_url }}">{{ 'accounts.logout' | t }}</a></p>
    <h2 class="h4">{{ 'accounts.orders' | t }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <ul class="order-list">
          {%- for order in customer.orders -%}
            <li><a href="{{ order.customer_url }}">{{ order.name }}</a> · {{ order.created_at | date: '%b %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }} · {{ order.total_price | money }}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p>{{ 'accounts.no_orders' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
    {%- endpaginate -%}
    <h2 class="h4">{{ 'accounts.default_address' | t }}</h2>
    {{ customer.default_address | format_address }}
    <p><a href="{{ routes.account_addresses_url }}">{{ 'accounts.manage_addresses' | t: total: customer.addresses_count }}</a></p>
  </div>
</section>
