<section class="page-section section-pad-md">
  <div class="page-width page-width--narrow">
    <p><a href="{{ routes.account_url }}">{{ 'accounts.back' | t }}</a></p>
    <h1 class="h2">{{ 'accounts.order' | t: name: order.name }}</h1>
    <p>{{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
    <ul class="order-list">
      {%- for line_item in order.line_items -%}
        <li>{{ line_item.title }} × {{ line_item.quantity }} · {{ line_item.final_line_price | money }}
          {%- if line_item.fulfillment -%} · <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'accounts.track' | t }}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <p>{{ 'cart.subtotal' | t }}: {{ order.line_items_subtotal_price | money }}</p>
    {%- for shipping_method in order.shipping_methods -%}<p>{{ 'accounts.shipping' | t }} ({{ shipping_method.title }}): {{ shipping_method.price | money }}</p>{%- endfor -%}
    <p>{{ 'accounts.tax' | t }}: {{ order.tax_price | money }}</p>
    <p><strong>{{ 'accounts.total' | t }}: {{ order.total_price | money_with_currency }}</strong></p>
    <h2 class="h4">{{ 'accounts.shipping_address' | t }}</h2>
    {{ order.shipping_address | format_address }}
  </div>
</section>
