<section class="page-section section-pad-md">
  <div class="page-width page-width--narrow account-form">
    <h1 class="h2">Log in</h1>
    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}
      <label for="LoginEmail">Email</label>
      <input id="LoginEmail" type="email" name="customer[email]" autocomplete="email" required>
      {%- if form.password_needed -%}
        <label for="LoginPassword">Password</label>
        <input id="LoginPassword" type="password" name="customer[password]" autocomplete="current-password">
        <a href="#recover" class="account-form__link">Forgot your password?</a>
      {%- endif -%}
      <button class="btn btn--dark btn--full" type="submit">Log in</button>
    {%- endform -%}
    <p class="account-form__alt"><a href="{{ routes.account_register_url }}">Create an account</a></p>

    <div id="recover" class="account-form__recover">
      <h2 class="h4">Reset your password</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}<p role="status">We've sent you an email with a link to reset your password.</p>{%- endif -%}
        {{ form.errors | default_errors }}
        <label for="RecoverEmail">Email</label>
        <input id="RecoverEmail" type="email" name="email" autocomplete="email" required>
        <button class="btn btn--ghost" type="submit">Send reset link</button>
      {%- endform -%}
    </div>
  </div>
</section>
