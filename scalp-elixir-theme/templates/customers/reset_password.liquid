<section class="page-section section-pad-md">
  <div class="page-width page-width--narrow account-form">
    <h1 class="h2">Reset your password</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <label for="ResetPassword">New password</label>
      <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      <label for="ResetConfirm">Confirm password</label>
      <input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="btn btn--dark btn--full" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</section>
