{
  "name": "potwise",
  "version": "0.1.0",
  "private": true,
  "description": "Potwise (Pantry Chef AI): cook what you already have. Student portfolio project.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,screens -c blue,magenta \"node --no-warnings --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "build:preview": "vite build --config vite.demo.config.js",
    "start": "node --no-warnings server/index.js",
    "test": "node --no-warnings --test --test-reporter=spec \"server/test/*.test.js\"",
    "test:e2e": "node e2e/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
